<div id="homepage" v-cloak class="font-sans antialiased text-gray-900 bg-white">
  
  <div class="relative bg-[#0a0a0a] overflow-hidden">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-[#c9a861] opacity-10 blur-[120px] rounded-full -mr-40 -mt-20 pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-[#c9a861] opacity-5 blur-[100px] rounded-full -ml-20 -mb-20 pointer-events-none"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 py-24 md:py-32 lg:py-40 flex flex-col items-center text-center">
      
      <div class="inline-flex items-center space-x-2 bg-white/10 backdrop-blur-md border border-white/10 rounded-full px-4 py-1.5 mb-8">
        <span class="w-2 h-2 rounded-full bg-[#c9a861]"></span>
        <span class="text-xs font-medium text-white uppercase tracking-widest">Finance Evolved</span>
      </div>

      <h1 class="text-5xl md:text-7xl font-medium text-white tracking-tight mb-6">
        Make your financial stress go <span class="text-[#c9a861] italic font-serif">Poof!</span>
      </h1>

      <p class="text-lg md:text-xl text-[#a3a3a3] max-w-2xl mb-10 leading-relaxed">
        The elegant expense manager for those who value clarity. Track accounts, analyze trends, and build wealth with a professional dashboard designed for you.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
        <a href="/signup" class="px-8 py-4 bg-[#c9a861] text-white rounded-xl font-medium text-lg hover:bg-[#b8956a] transition-all shadow-lg hover:shadow-[#c9a861]/25 hover:-translate-y-1">
          Get Started Free
        </a>
        <a href="/login" class="px-8 py-4 bg-transparent border border-white/20 text-white rounded-xl font-medium text-lg hover:bg-white/10 transition-colors">
          Sign In
        </a>
      </div>

      <div class="mt-20 relative w-full max-w-5xl">
        <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-transparent to-transparent z-20 h-full w-full"></div>
        <div class="rounded-xl overflow-hidden shadow-2xl border border-white/10 bg-[#171717]">
            <div class="bg-[#262626] px-4 py-3 flex items-center space-x-2">
                <div class="w-3 h-3 rounded-full bg-red-500"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                <div class="w-3 h-3 rounded-full bg-green-500"></div>
            </div>
            <div class="p-8 grid grid-cols-1 md:grid-cols-3 gap-6 opacity-80 grayscale-[30%]">
                <div class="bg-[#0a0a0a] h-40 rounded-lg border border-white/5"></div>
                <div class="bg-[#0a0a0a] h-40 rounded-lg border border-white/5"></div>
                <div class="bg-[#0a0a0a] h-40 rounded-lg border border-white/5"></div>
                <div class="md:col-span-2 bg-[#0a0a0a] h-64 rounded-lg border border-white/5"></div>
                <div class="bg-[#0a0a0a] h-64 rounded-lg border border-white/5"></div>
            </div>
        </div>
      </div>

    </div>
  </div>

  <div class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      
      <div class="text-center mb-16">
        <h2 class="text-3xl font-medium text-[#0a0a0a] mb-4">Precision Financial Tools</h2>
        <p class="text-[#737373]">Everything you need to take control, minus the clutter.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        
        <div class="group p-8 rounded-2xl bg-[#fafaf9] border border-[rgba(0,0,0,0.05)] hover:border-[#c9a861] transition-colors duration-300">
          <div class="w-12 h-12 bg-[#0a0a0a] rounded-xl flex items-center justify-center mb-6 group-hover:bg-[#c9a861] transition-colors">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
          </div>
          <h3 class="text-xl font-medium text-[#0a0a0a] mb-3">Multi-Account Tracking</h3>
          <p class="text-[#737373] leading-relaxed">
            Manage your Checking, Savings, and Credit Cards in one unified dashboard. Stop switching between bank apps.
          </p>
        </div>

        <div class="group p-8 rounded-2xl bg-[#fafaf9] border border-[rgba(0,0,0,0.05)] hover:border-[#c9a861] transition-colors duration-300">
          <div class="w-12 h-12 bg-[#0a0a0a] rounded-xl flex items-center justify-center mb-6 group-hover:bg-[#c9a861] transition-colors">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
          </div>
          <h3 class="text-xl font-medium text-[#0a0a0a] mb-3">Insightful Trends</h3>
          <p class="text-[#737373] leading-relaxed">
            Visualize your spending habits with beautiful charts. Understand exactly where your money goes every month.
          </p>
        </div>

        <div class="group p-8 rounded-2xl bg-[#fafaf9] border border-[rgba(0,0,0,0.05)] hover:border-[#c9a861] transition-colors duration-300">
          <div class="w-12 h-12 bg-[#0a0a0a] rounded-xl flex items-center justify-center mb-6 group-hover:bg-[#c9a861] transition-colors">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          </div>
          <h3 class="text-xl font-medium text-[#0a0a0a] mb-3">Bank-Grade Security</h3>
          <p class="text-[#737373] leading-relaxed">
            Your data is encrypted and secure. We focus on privacy so you can focus on building your net worth.
          </p>
        </div>

      </div>
    </div>
  </div>

  <div class="bg-[#0a0a0a] border-t border-white/10 py-16">
    <div class="max-w-7xl mx-auto px-6 text-center">
      <h2 class="text-3xl font-medium text-white mb-6">Ready to upgrade your finances?</h2>
      <a href="/signup" class="inline-block px-10 py-4 bg-[#c9a861] text-white rounded-xl font-medium text-lg hover:bg-[#b8956a] transition-colors">
        Create Your Free Account
      </a>
      <p class="mt-8 text-sm text-[#737373]">&copy; <%= new Date().getFullYear() %> Poof! Expense Manager. All rights reserved.</p>
    </div>
  </div>

</div>

<%- /* Expose locals as `window.SAILS_LOCALS` :: */ exposeLocalsToBrowser() %>