<div class="min-h-[80vh] flex items-center justify-center px-6 py-12 bg-[#fafaf9]">
  
  <div class="fixed top-24 left-6 md:left-12">
    <a href="/accounts" class="flex items-center text-sm text-[#737373] hover:text-[#0a0a0a] transition-colors group">
      <svg class="w-5 h-5 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      Back to Dashboard
    </a>
  </div>

  <div class="w-full max-w-md">
    <div class="bg-white rounded-3xl shadow-2xl border border-[rgba(0,0,0,0.05)] overflow-hidden">
      
      <div class="relative bg-[#0a0a0a] p-8 text-center overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-[#c9a861] opacity-20 blur-[50px] rounded-full -mr-16 -mt-16"></div>
        <div class="relative z-10">
          <h1 class="text-3xl font-medium text-white tracking-tight">New Account</h1>
          <p class="text-[#737373] text-sm mt-2">Add a new source to your net worth</p>
        </div>
      </div>

      <div class="p-8 md:p-10">
        <form action="/api/v1/account" method="POST" class="space-y-6">
          
          <div>
            <label for="account-name" class="block text-xs font-bold text-[#737373] uppercase tracking-widest mb-2">
              Account Name
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-[#c9a861]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
                </svg>
              </div>
              <input 
                type="text"
                id="account-name"
                name="name"
                class="w-full pl-12 pr-4 py-4 bg-[#f9f9f8] border border-[rgba(0,0,0,0.08)] rounded-2xl text-[#0a0a0a] placeholder-[#a3a3a3] focus:ring-2 focus:ring-[#c9a861] focus:border-transparent transition-all outline-none"
                placeholder="e.g. HDFC Savings, Cash, Crypto"
                required
                autofocus>
            </div>
          </div>

          <button type="submit" class="w-full group relative flex justify-center py-4 px-4 border border-transparent font-medium rounded-2xl text-white bg-[#0a0a0a] hover:bg-[#262626] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#c9a861] transition-all shadow-lg hover:shadow-xl active:scale-[0.98]">
            <span class="absolute left-0 inset-y-0 flex items-center pl-4 text-[#c9a861]">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
              </svg>
            </span>
            Create Account
          </button>

          <p class="text-center text-[11px] text-[#a3a3a3] px-4">
            By creating this account, it will immediately appear on your dashboard with a starting balance of ₹ 0.
          </p>
        </form>
      </div>
    </div>
  </div>
</div>