<div class="space-y-8 px-6 py-10 max-w-7xl mx-auto">
  
  <div class="flex items-end justify-between">
    <div>
      <h1 class="text-2xl tracking-tight font-medium text-[#0a0a0a]">Your Accounts</h1>
      <p class="text-sm text-[#737373] mt-1">Manage your connected banking sources</p>
    </div>
    
    <button onclick="window.location.href='/accounts/create'" class="px-6 py-2.5 bg-[#0a0a0a] text-white rounded-lg hover:bg-[#262626] transition-colors shadow-sm font-medium flex items-center space-x-2">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
      <span>Create Account</span>
    </button>
  </div>

  <div class="relative bg-[#0a0a0a] rounded-2xl p-8 overflow-hidden shadow-lg">
    <div class="absolute top-0 right-0 w-64 h-64 bg-[#c9a861] opacity-10 blur-[80px] rounded-full -mr-20 -mt-20"></div>
    
    <div class="relative z-10 flex flex-col sm:flex-row justify-between items-start sm:items-center">
      <div>
        <p class="text-[#737373] text-sm font-medium mb-1 uppercase tracking-wider">Total Net Worth</p>
        <h2 class="text-4xl font-medium text-white tracking-tight">
          ₹ <%= totalCombinedBalance ? totalCombinedBalance.toLocaleString('en-IN') : '0' %>
        </h2>
      </div>
      <div class="mt-4 sm:mt-0 px-4 py-2 bg-[#ffffff] bg-opacity-10 rounded-lg backdrop-blur-sm border border-white/10">
        <span class="text-[#c9a861] text-sm font-medium">
          <%= accounts.length %> Active Accounts
        </span>
      </div>
    </div>
  </div>

  <% if (accounts && accounts.length > 0) { %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

      <% accounts.forEach(function(account, index) { 
          const isShared = account.owner.id !== currentUserId;
          const imageNum = (index % 4) + 1;
          const bgImage = '/images/card-' + imageNum + '.png'; 
      %>
        
        <div onclick="window.location.href='/accounts/<%= account.id %>'" 
             class="account-card relative group bg-white border border-[rgba(0,0,0,0.08)] rounded-2xl h-64 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 overflow-hidden cursor-pointer">
          
          <div class="absolute right-0 top-0 bottom-0 w-1/2 h-full z-0 pointer-events-none">
             <img src="<%= bgImage %>" alt="Background" class="w-full h-full object-cover rounded-l-[3rem] opacity-90 transition-transform duration-700 group-hover:scale-105" />
             <div class="absolute inset-0 bg-gradient-to-l from-transparent to-white/10 rounded-l-[3rem]"></div>
          </div>

          <div class="relative z-10 w-[60%] h-full p-8 flex flex-col justify-between pointer-events-none">
            
            <div>
               <div class="flex items-center space-x-2 mb-3">
                 <span class="w-2 h-2 rounded-full <%= isShared ? 'bg-blue-500' : 'bg-[#c9a861]' %>"></span>
                 <p class="text-xs font-bold text-[#737373] uppercase tracking-wider">
                    <%= isShared ? 'Shared Account' : 'Personal' %>
                 </p>
               </div>

               <h3 class="text-2xl font-medium text-[#0a0a0a] leading-tight truncate pr-4">
                 <%= account.name %>
               </h3>
               
               <p class="text-xs text-[#737373] mt-1">
                 <% if (isShared) { %>
                    <span class="text-blue-600 font-medium italic">Shared by <%= account.owner.fullName || account.owner.emailAddress %></span>
                 <% } else { %>
                    **** <%= account.accountNumber ? account.accountNumber.slice(-4) : '0000' %>
                 <% } %>
               </p>
            </div>

            <div class="mt-auto">
              <p class="text-xs text-[#737373] mb-1">Available Balance</p>
              <p class="text-3xl tracking-tight font-medium text-[#0a0a0a]">
                ₹ <%= account.balance ? account.balance.toLocaleString('en-IN') : '0' %>
              </p>
            </div>

            <div class="mt-4 pt-4 border-t border-[rgba(0,0,0,0.06)]">
               <span class="inline-flex items-center text-sm font-medium text-[#c9a861] group-hover:text-[#b8956a] transition-colors">
                  View Transactions
                  <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
               </span>
            </div>

          </div>

          <div class="absolute top-6 right-6 z-20">
              <button type="button" 
                      onclick="toggleMenu(event, '<%= account.id %>')"
                      class="w-10 h-10 flex items-center justify-center rounded-full bg-white/90 backdrop-blur-sm text-[#0a0a0a] shadow-sm hover:bg-white transition-all focus:outline-none"
                      aria-label="Options">
                <svg class="w-5 h-5 pointer-events-none" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0-6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 12c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
                </svg>
              </button>

              <div id="menu-<%= account.id %>" 
                   class="dropdown-content hidden absolute right-0 mt-2 w-48 bg-white border border-[rgba(0,0,0,0.08)] rounded-xl shadow-xl z-50 overflow-hidden">
                <form action="/api/v1/account/<%= account.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this account?');">
                  <button type="submit" onclick="event.stopPropagation()" class="w-full text-left px-4 py-3 text-sm text-red-600 hover:bg-[#f5f5f4] transition-colors flex items-center space-x-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                    <% if (account.owner.id === currentUserId) { %>
                      <span>Delete Account</span>
                    <% } else { %>
                      <span>Leave Account</span>
                    <% } %>
                  </button>
                </form>
              </div>
          </div>

        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="bg-white border border-[rgba(0,0,0,0.08)] rounded-2xl p-12 text-center">
      <div class="w-16 h-16 bg-[#f5f5f4] rounded-full flex items-center justify-center mx-auto mb-4 text-[#737373]">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
      </div>
      <h3 class="text-lg font-medium text-[#0a0a0a] mb-2">No accounts found</h3>
      <p class="text-[#737373]">Get started by adding your first bank account.</p>
    </div>
  <% } %>
</div>

<script>
  function toggleMenu(event, id) {
    event.stopPropagation();
    event.preventDefault();
    const menu = document.getElementById('menu-' + id);
    const isOpen = !menu.classList.contains('hidden');
    document.querySelectorAll('.dropdown-content').forEach(el => el.classList.add('hidden'));
    if (!isOpen) menu.classList.remove('hidden');
  }

  document.addEventListener('click', () => {
    document.querySelectorAll('.dropdown-content').forEach(el => el.classList.add('hidden'));
  });
</script>