<div class="max-w-7xl mx-auto px-6 py-10 space-y-8">

  <div class="relative bg-[#0a0a0a] rounded-3xl p-8 md:p-12 overflow-hidden shadow-2xl text-white">
    <div class="absolute top-0 right-0 w-64 h-64 bg-[#c9a861] opacity-20 blur-[100px] rounded-full -mr-20 -mt-20"></div>
    <div class="relative z-10 flex flex-col md:flex-row justify-between items-start md:items-end gap-6">
      <div>
        <a href="/accounts" class="inline-flex items-center text-sm text-[#737373] hover:text-white mb-4 transition-colors">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Back to Accounts
        </a>
        <h1 class="text-4xl font-medium tracking-tight mb-2"><%= account.name %></h1>
        <p class="text-[#a3a3a3] font-mono">**** <%= account.accountNumber ? account.accountNumber.slice(-4) : '0000' %></p>
      </div>

      <div class="flex flex-col items-end gap-4">
        <% if (account.owner.id === currentUserId) { %>
        <button onclick="openShareModal()" class="px-4 py-2 bg-white/10 hover:bg-white/20 border border-white/10 rounded-lg backdrop-blur-sm text-sm font-medium transition-colors flex items-center gap-2">
          <svg class="w-4 h-4 text-[#c9a861]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>
          Add Member
        </button>
        <% } else { %>
        <div class="px-3 py-1 bg-blue-500/20 border border-blue-500/30 rounded-full">
          <span class="text-[10px] text-blue-400 font-bold uppercase tracking-widest">Shared Access</span>
        </div>
        <% } %>

        <div class="text-right">
          <p class="text-sm text-[#a3a3a3] mb-1">Total Balance</p>
          <p class="text-5xl font-medium tracking-tight">₹ <%= account.balance ? account.balance.toLocaleString('en-IN') : 0 %></p>
        </div>
      </div>
    </div>
  </div>

  <% if ((account.sharedWith && account.sharedWith.length > 0) || account.owner.id !== currentUserId) { %>
  <div class="bg-white border border-[rgba(0,0,0,0.08)] rounded-2xl p-6 shadow-sm">
    <h3 class="text-xs font-bold text-[#737373] mb-4 uppercase tracking-wider">Account Members</h3>
    <div class="flex flex-wrap gap-4">
      <div class="flex items-center gap-3 bg-[#fafaf9] px-3 py-2 rounded-xl border border-[#c9a861]/20">
        <div class="w-8 h-8 rounded-full bg-[#c9a861] flex items-center justify-center text-white text-xs font-bold shadow-sm">
          <%= account.owner.fullName.charAt(0) %>
        </div>
        <div>
          <p class="text-xs font-medium text-[#0a0a0a]"><%= account.owner.fullName %></p>
          <p class="text-[10px] text-[#c9a861] font-bold uppercase">Owner</p>
        </div>
      </div>
      <% account.sharedWith.forEach(member => { %>
      <div class="flex items-center gap-3 bg-[#fafaf9] px-3 py-2 rounded-xl border border-gray-100 group transition-all hover:border-gray-200">
        <div class="w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center text-gray-600 text-xs font-bold">
          <%= member.fullName.charAt(0) %>
        </div>
        <div>
          <p class="text-xs font-medium text-[#0a0a0a]"><%= member.fullName %></p>
          <p class="text-[10px] text-gray-400">Member</p>
        </div>
        <% if (account.owner.id === currentUserId) { %>
        <button onclick="removeMember('<%= member.id %>')" class="ml-1 p-1 text-gray-300 hover:text-red-500 transition-colors" title="Remove Member">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
        <% } %>
      </div>
      <% }) %>
    </div>
  </div>
  <% } %>

  <div>
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-medium text-[#0a0a0a]">Recent Transactions</h2>
      <button onclick="openModal('create')" class="flex items-center space-x-2 px-4 py-2 bg-[#c9a861] hover:bg-[#b8956a] text-white rounded-lg transition-colors shadow-sm text-sm font-medium">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>Add Transaction</span>
      </button>
    </div>

    <% if (transactions && transactions.length > 0) { %>
    <div class="bg-white border border-[rgba(0,0,0,0.08)] rounded-2xl overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-[#fafaf9] border-b border-[rgba(0,0,0,0.05)]">
            <tr>
              <th class="px-6 py-4 font-medium text-[#737373]">Date</th>
              <th class="px-6 py-4 font-medium text-[#737373]">Category</th>
              <th class="px-6 py-4 font-medium text-[#737373]">Note</th>
              <th class="px-6 py-4 font-medium text-[#737373] text-right">Amount</th>
              <th class="px-6 py-4 font-medium text-[#737373] text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[rgba(0,0,0,0.05)]">
            <% transactions.forEach(function(txn) { %>
            <tr class="hover:bg-[#fafaf9] transition-colors group">
              <td class="px-6 py-4 text-[#737373]"><%= new Date(txn.date).toLocaleDateString() %></td>
              <td class="px-6 py-4 font-medium text-[#0a0a0a]">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800"><%= txn.category %></span>
              </td>
              <td class="px-6 py-4 text-[#737373] max-w-xs truncate"><%= txn.note || '-' %></td>
              <td class="px-6 py-4 text-right font-medium <%= txn.amount > 0 ? 'text-emerald-600' : (txn.amount < 0 ? 'text-red-600' : 'text-[#0a0a0a]') %>">
                <%= txn.amount > 0 ? '+' : (txn.amount < 0 ? '-' : '') %> ₹ <%= Math.abs(txn.amount).toLocaleString('en-IN') %>
              </td>
              <td class="px-6 py-4 text-right">
                <div class="flex items-center justify-end gap-3 opacity-0 group-hover:opacity-100 transition-opacity">
                  <button onclick='openModal("edit", <%- JSON.stringify(txn) %>)' class="text-gray-400 hover:text-[#c9a861] transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
                    </svg>
                  </button>
                  <button onclick="deleteTransaction('<%= txn.id %>')" class="text-gray-400 hover:text-red-600 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                  </button>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
    <% } else { %>
    <div class="bg-white border border-[rgba(0,0,0,0.08)] rounded-2xl p-12 text-center">
      <h3 class="text-lg font-medium text-[#0a0a0a]">No transactions yet</h3>
      <p class="text-[#737373] mt-1 text-sm">Add your first income or expense to this account.</p>
    </div>
    <% } %>
  </div>
</div>

<div id="transactionModal" class="hidden fixed inset-0 z-50 overflow-y-auto">
  <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
    <div class="fixed inset-0 bg-[#0a0a0a] bg-opacity-75 transition-opacity" onclick="closeModal()"></div>
    <span class="hidden sm:inline-block sm:align-middle sm:h-screen">&#8203;</span>

    <div class="inline-block align-bottom bg-white rounded-2xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg w-full">
      <div class="bg-[#fafaf9] px-6 py-4 border-b border-[rgba(0,0,0,0.08)] flex justify-between items-center">
        <h3 id="modalTitle" class="text-lg font-medium text-[#0a0a0a]">New Transaction</h3>
        <button onclick="closeModal()" class="text-[#737373] hover:text-[#0a0a0a] text-2xl leading-none">&times;</button>
      </div>

      <form onsubmit="submitTransaction(event)" id="txnForm" class="p-6 space-y-4">
        <input type="hidden" name="accountId" value="<%= account.id %>">
        <input type="hidden" name="id" id="txnId">
        <input type="hidden" id="mode" value="create">

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-[#737373] mb-1">Type</label>
            <select name="type" id="txnType" onchange="toggleTransferUI()" class="w-full px-3 py-2 border border-[rgba(0,0,0,0.12)] rounded-lg focus:ring-[#c9a861] bg-white">
              <option value="expense">Expense</option>
              <option value="income">Income</option>
              <option value="transfer">Transfer</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-[#737373] mb-1">Amount</label>
            <div class="relative">
              <span class="absolute left-3 top-2.5 text-[#737373]">₹</span>
              <input type="number" name="amount" id="txnAmount" step="0.01" required class="w-full pl-8 pr-4 py-2 border border-[rgba(0,0,0,0.12)] rounded-lg focus:ring-[#c9a861] focus:border-[#c9a861]" placeholder="0.00">
            </div>
          </div>
        </div>

        <div id="transferField" class="hidden">
          <label class="block text-sm font-medium text-[#737373] mb-1">Transfer To</label>
          <select name="toAccountId" id="txnToAccount" class="w-full px-3 py-2 border border-[rgba(0,0,0,0.12)] rounded-lg focus:ring-[#c9a861] bg-white">
            <% myAccounts.forEach(function(acc) { %>
            <% if(acc.id !== account.id) { %>
            <option value="<%= acc.id %>"><%= acc.name %></option>
            <% } %>
            <% }); %>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-[#737373] mb-1">Category</label>
          <input type="text" name="category" id="txnCategory" required class="w-full px-4 py-2 border border-[rgba(0,0,0,0.12)] rounded-lg focus:ring-[#c9a861] focus:border-[#c9a861]" placeholder="e.g. Food, Salary">
        </div>

        <div>
          <label class="block text-sm font-medium text-[#737373] mb-1">Note</label>
          <input type="text" name="note" id="txnNote" class="w-full px-4 py-2 border border-[rgba(0,0,0,0.12)] rounded-lg focus:ring-[#c9a861] focus:border-[#c9a861]" placeholder="Optional details...">
        </div>

        <div>
          <label class="block text-sm font-medium text-[#737373] mb-1">Date</label>
          <input type="date" name="date" id="txnDate" class="w-full px-4 py-2 border border-[rgba(0,0,0,0.12)] rounded-lg focus:ring-[#c9a861] focus:border-[#c9a861]">
        </div>

        <button type="submit" class="w-full py-3 bg-[#0a0a0a] text-white rounded-lg font-medium hover:bg-[#262626] transition-colors shadow-lg flex justify-center items-center">
          <span id="btnText">Save Transaction</span>
          <svg id="btnSpinner" class="hidden animate-spin ml-2 h-5 w-5 text-white" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>
      </form>
    </div>
  </div>
</div>

<div id="shareModal" class="hidden fixed inset-0 z-50 overflow-y-auto">
  <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
    <div class="fixed inset-0 bg-[#0a0a0a] bg-opacity-75 transition-opacity" onclick="closeShareModal()"></div>
    <span class="hidden sm:inline-block sm:align-middle sm:h-screen">&#8203;</span>

    <div class="inline-block align-bottom bg-white rounded-2xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg w-full">
      <div class="bg-[#fafaf9] px-6 py-4 border-b border-[rgba(0,0,0,0.08)] flex justify-between items-center">
        <h3 class="text-lg font-medium text-[#0a0a0a]">Add Member</h3>
        <button onclick="closeShareModal()" class="text-[#737373] hover:text-[#0a0a0a] text-2xl leading-none">&times;</button>
      </div>
      <form onsubmit="submitShare(event)" class="p-6 space-y-4">
        <input type="hidden" name="accountId" value="<%= account.id %>">
        <div>
          <label class="block text-sm font-medium text-[#737373] mb-1">User Email</label>
          <input type="email" name="email" required class="w-full px-4 py-2 border border-[rgba(0,0,0,0.12)] rounded-lg focus:ring-[#c9a861] focus:border-[#c9a861]" placeholder="partner@example.com">
          <p class="text-xs text-[#a3a3a3] mt-2">The user must have a registered account in Poof!.</p>
        </div>
        <button type="submit" class="w-full py-3 bg-[#0a0a0a] text-white rounded-lg font-medium hover:bg-[#262626] transition-colors shadow-lg">
          Invite Member
        </button>
      </form>
    </div>
  </div>
</div>

<div id="toast" class="fixed bottom-5 right-5 z-[100] transform transition-all duration-300 translate-y-20 opacity-0 pointer-events-none">
  <div id="toastCard" class="bg-[#0a0a0a] border border-red-600 shadow-2xl rounded-xl p-4 flex items-start max-w-sm">
    <div id="toastIcon" class="flex-shrink-0 w-5 h-5 mt-0.5 text-red-500"></div>
    <div class="ml-3 w-0 flex-1">
      <p id="toastTitle" class="text-sm font-medium text-white"></p>
      <p id="toastMessage" class="mt-1 text-sm text-[#a3a3a3]"></p>
    </div>
  </div>
</div>

<script>
  // --- UTILS ---
  function showToast(title, message, isError = true) {
    const toast = document.getElementById('toast');
    const toastCard = document.getElementById('toastCard');
    const toastTitle = document.getElementById('toastTitle');
    const toastMessage = document.getElementById('toastMessage');
    const toastIcon = document.getElementById('toastIcon');

    toastTitle.textContent = title;
    toastMessage.textContent = message;

    if (isError) {
      toastCard.className = "bg-[#0a0a0a] border border-red-600 shadow-2xl rounded-xl p-4 flex items-start max-w-sm";
      toastIcon.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
      toastIcon.className = "flex-shrink-0 w-5 h-5 mt-0.5 text-red-500";
    } else {
      toastCard.className = "bg-[#0a0a0a] border border-[#c9a861] shadow-2xl rounded-xl p-4 flex items-start max-w-sm";
      toastIcon.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
      toastIcon.className = "flex-shrink-0 w-5 h-5 mt-0.5 text-[#c9a861]";
    }

    toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
    setTimeout(() => toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none'), 5000);
  }

  // --- TRANSACTION MODAL ---
  function openModal(mode, txnData = null) {
    document.getElementById('transactionModal').classList.remove('hidden');
    document.getElementById('mode').value = mode;
    const form = document.getElementById('txnForm');
    form.reset();

    if (mode === 'edit' && txnData) {
      document.getElementById('modalTitle').textContent = "Edit Transaction";
      document.getElementById('txnId').value = txnData.id;
      document.getElementById('txnType').value = txnData.type;
      document.getElementById('txnAmount').value = Math.abs(txnData.amount);
      document.getElementById('txnCategory').value = txnData.category;
      document.getElementById('txnNote').value = txnData.note || '';
      const date = new Date(txnData.date);
      document.getElementById('txnDate').value = date.toISOString().split('T')[0];
      toggleTransferUI();
    } else {
      document.getElementById('modalTitle').textContent = "New Transaction";
      document.querySelector('input[name="date"]').valueAsDate = new Date();
    }
  }

  function closeModal() {
    document.getElementById('transactionModal').classList.add('hidden');
  }

  function toggleTransferUI() {
    const type = document.getElementById('txnType').value;
    const transferField = document.getElementById('transferField');
    const categoryInput = document.getElementById('txnCategory');
    if (type === 'transfer') {
      transferField.classList.remove('hidden');
      categoryInput.value = 'Transfer';
    } else {
      transferField.classList.add('hidden');
      if (categoryInput.value === 'Transfer') categoryInput.value = '';
    }
  }

  async function submitTransaction(e) {
    e.preventDefault();
    const btnText = document.getElementById('btnText');
    const btnSpinner = document.getElementById('btnSpinner');
    btnText.textContent = 'Processing...';
    btnSpinner.classList.remove('hidden');

    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());
    data.amount = parseFloat(data.amount);

    const mode = document.getElementById('mode').value;
    const url = mode === 'edit' ? '/api/v1/transactions/update' : '/api/v1/transactions';

    try {
      const response = await fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(data)
      });
      if (response.ok) {
        window.location.reload();
      } else {
        const result = await response.json();
        showToast("Error", result.message || "Action Failed", true);
        btnText.textContent = 'Save Transaction';
        btnSpinner.classList.add('hidden');
      }
    } catch (error) {
      showToast("Network Error", "Could not connect to server", true);
      btnText.textContent = 'Save Transaction';
      btnSpinner.classList.add('hidden');
    }
  }

  async function deleteTransaction(id) {
    if (!confirm("Are you sure you want to delete this transaction?")) return;
    try {
      const response = await fetch('/api/v1/transactions/delete', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          id
        })
      });
      if (response.ok) window.location.reload();
      else showToast("Error", "Could not delete transaction", true);
    } catch (e) {
      showToast("Error", "Network Error", true);
    }
  }

  // --- SHARING LOGIC ---
  function openShareModal() {
    document.getElementById('shareModal').classList.remove('hidden');
  }

  function closeShareModal() {
    document.getElementById('shareModal').classList.add('hidden');
  }

  async function submitShare(e) {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());
    try {
      const response = await fetch('/api/v1/account/share', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(data)
      });
      if (response.ok) {
        window.location.reload();
      } else {
        const result = await response.json();
        showToast("Error", result.message || "Failed to share", true);
      }
    } catch (e) {
      showToast("Error", "Network Error", true);
    }
  }

  // --- MEMBER MANAGEMENT ---
  async function removeMember(userIdToRemove) {
    if (!confirm("Remove this user's access to the account?")) return;
    try {
      const response = await fetch('/api/v1/account/remove-member', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          accountId: '<%= account.id %>',
          userIdToRemove
        })
      });
      if (response.ok) window.location.reload();
      else showToast("Error", "Failed to remove member.", true);
    } catch (e) {
      showToast("Error", "Network Error", true);
    }
  }
</script>