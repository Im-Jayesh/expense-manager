<div id="signup" class="min-h-screen bg-[#fafaf9] flex flex-col justify-center py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <div class="bg-white py-8 px-4 shadow-xl border border-[rgba(0,0,0,0.08)] sm:rounded-2xl sm:px-10">
      <form action="/signup" method="POST">
        <div class="mb-5">
          <label class="block text-sm font-medium mb-1.5">Full name</label>
          <input name="fullName" type="text" required class="block w-full px-4 py-3 rounded-lg border border-[rgba(0,0,0,0.12)]">
        </div>
        <div class="mb-5">
          <label class="block text-sm font-medium mb-1.5">Email address</label>
          <input name="emailAddress" type="email" required class="block w-full px-4 py-3 rounded-lg border border-[rgba(0,0,0,0.12)]">
        </div>
        <div class="mb-5">
          <label class="block text-sm font-medium mb-1.5">Choose password</label>
          <input name="password" type="password" required class="block w-full px-4 py-3 rounded-lg border border-[rgba(0,0,0,0.12)]">
        </div>
        <button type="submit" class="w-full py-3 px-4 rounded-lg text-white bg-gradient-to-r from-[#c9a861] to-[#d4af37]">
          Create account
        </button>
      </form>
    </div>
  </div>
</div>