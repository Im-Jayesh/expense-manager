<div id="signup" class="min-h-screen bg-[#fafaf9] flex flex-col justify-center py-12 sm:px-6 lg:px-8 font-sans text-[#0a0a0a]">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-medium tracking-tight text-[#0a0a0a]">Create an account</h1>
      <p class="mt-2 text-sm text-[#737373]">Let's get started!</p>
    </div>

    <div class="bg-white py-8 px-4 shadow-xl border border-[rgba(0,0,0,0.08)] sm:rounded-2xl sm:px-10 relative">
      <form action="/signup" method="POST">
        
        <div class="mb-5">
          <label for="full-name" class="block text-sm font-medium text-[#0a0a0a] mb-1.5">Full name</label>
          <input name="fullName" type="text" required id="full-name" class="appearance-none block w-full px-4 py-3 rounded-lg border border-[rgba(0,0,0,0.12)] focus:outline-none focus:ring-2 focus:ring-[#c9a861]/20 focus:border-[#c9a861] transition-colors sm:text-sm" placeholder="Sturgis P. Sturgeon">
        </div>

        <div class="mb-5">
          <label for="email-address" class="block text-sm font-medium text-[#0a0a0a] mb-1.5">Email address</label>
          <input name="emailAddress" type="email" required id="email-address" class="appearance-none block w-full px-4 py-3 rounded-lg border border-[rgba(0,0,0,0.12)] focus:outline-none focus:ring-2 focus:ring-[#c9a861]/20 focus:border-[#c9a861] transition-colors sm:text-sm" placeholder="sturgeon@example.com">
        </div>

        <div class="mb-5">
          <label for="password" class="block text-sm font-medium text-[#0a0a0a] mb-1.5">Choose a password</label>
          <input name="password" type="password" required id="password" class="appearance-none block w-full px-4 py-3 rounded-lg border border-[rgba(0,0,0,0.12)] focus:outline-none focus:ring-2 focus:ring-[#c9a861]/20 focus:border-[#c9a861] transition-colors sm:text-sm" placeholder="••••••••">
        </div>

        <div class="flex items-start mb-6">
          <div class="flex items-center h-5">
            <input id="terms-agreement" name="agreed" type="checkbox" required class="h-4 w-4 text-[#c9a861] focus:ring-[#c9a861] border-gray-300 rounded cursor-pointer">
          </div>
          <div class="ml-3 text-sm text-[#737373]">
            <label for="terms-agreement">I agree to the <a href="/terms" class="text-[#c9a861] underline">terms of service</a>.</label>
          </div>
        </div>

        <button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-gradient-to-r from-[#c9a861] to-[#d4af37] transition-all transform active:scale-[0.98]">
          Create account
        </button>

      </form>

      <div class="mt-6 text-center">
        <p class="text-sm text-[#737373]">
          Have an account? <a href="/login" class="font-medium text-[#c9a861] underline">Sign in</a>
        </p>
      </div>
    </div>
  </div>
</div>